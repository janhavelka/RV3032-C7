# Doxygen configuration for RV3032-C7
# Generated and maintained for unified API documentation.

PROJECT_NAME           = "RV3032-C7"
PROJECT_BRIEF          = "RV3032-C7 embedded library API documentation"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO
OUTPUT_LANGUAGE        = English

MARKDOWN_SUPPORT       = YES
# Doxygen 1.9.7+: share section links with GitHub's README rendering.
MARKDOWN_ID_STYLE      = GITHUB
TOC_INCLUDE_HEADINGS   = 3
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO

SHOW_INCLUDE_FILES     = YES
INLINE_INFO            = YES
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
STRIP_CODE_COMMENTS    = NO

INPUT                  = README.md CHANGELOG.md CONTRIBUTING.md include/RV3032 \
                         docs/ARCHITECTURE.md docs/DEVICE_REFERENCE.md \
                         docs/IDF_PORT.md docs/VERIFICATION.md
FILE_PATTERNS          = *.h *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */.pio/* */.git/* */test/* */docs/doxygen/* */docs/reference-pdfs/*

USE_MDFILE_AS_MAINPAGE = README.md
FULL_PATH_NAMES        = NO
# Keep the public header's lifecycle and feature-group order.
SORT_MEMBER_DOCS       = NO
SUBGROUPING            = NO
SORT_BRIEF_DOCS        = YES
SORT_MEMBERS_CTORS_1ST = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = AUTO_LIGHT
GENERATE_TREEVIEW       = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO

WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES
QUIET                  = YES

# Public API documentation must not depend on a host-specific Graphviz install.
HAVE_DOT               = NO
